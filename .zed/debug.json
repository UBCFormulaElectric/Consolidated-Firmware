[
  // ==========================================
  // Python Debug Configurations (Debugpy)
  // ==========================================
  {
    "label": "Debug Pytest",
    "adapter": "Debugpy",
    "request": "launch",
    "module": "pytest",
    "args": [
      "$ZED_DIRNAME"
    ],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Debug JSON CAN (module)",
    "adapter": "Debugpy",
    "request": "launch",
    "module": "scripts.code_generation.jsoncan.generate_can_from_json",
    "args": [
      "--board",
      "VC",
      "--can_data_dir",
      "$ZED_WORKTREE_ROOT/can_bus/quintuna",
      "--output_dir",
      "temp",
      "--dbc_output"
    ],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Debug Telem Backend",
    "adapter": "Debugpy",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/software/tracksight/live_data/app/app.py",
    "cwd": "$ZED_WORKTREE_ROOT"
  },

