{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Launch: STM32CubeMX",
      "type": "shell",
      "command": "./STM32CubeMX",
      "group": "build",
      "linux": {
        "options": {
          "cwd": "/usr/local/STM32CubeMX/"
        }
      },
      "osx": {
        "options": {
          "cwd": "/Applications/STMicroelectronics/STM32CubeMX.app/Contents/MacOs"
        }
      }
    },
    {
      "label": "Format: Codebase",
      "type": "shell",
      "command": "python ${workspaceFolder}/scripts/utilities/fix_formatting.py",
      "group": "build",
      "options": {}
    },
    {
      "label": "CMake: Load",
      "detail": "CMake Generate step",
      "group": "build",
      "type": "cmake",
      "command": "configure",
      "preset": "${command:cmake.activeConfigurePresetName}"
    },
    {
      "label": "Build Embedded Hexray",
      "detail": "CMake Generate step",
      "group": "build",
      "type": "cmake",
      "command": "build",
      "targets": [
        "hexray_CRIT_app.hex",
        "hexray_DAM_app.hex",
        "hexray_FSM_app.hex",
        "hexray_RSM_app.hex",
      ]
    },
    {
      "label": "CMake: Clean",
      "detail": "CMake template clean task",
      "group": "build",
      "type": "cmake",
      "command": "clean",
      "preset": "${command:cmake.activeBuildPresetName}"
    },
    {
      "label": "Build Embedded: h7dev",
      "group": "build",
      "type": "cmake",
      "command": "build",
      "targets": [
        "h7dev.hex"
      ]
    },
    {
      "label": "Build Embedded: h5dev",
      "group": "build",
      "type": "cmake",
      "command": "build",
      "targets": [
        "h5dev.hex"
      ]
    },
    {
      "label": "Build Embedded: SSM",
      "group": "build",
      "type": "cmake",
      "command": "build",
      "targets": [
        "ssm.hex"
      ]
    },
    {
      "label": "Build Embedded: BMS (Hexray)",
      "group": "build",
      "type": "cmake",
      "command": "build",
