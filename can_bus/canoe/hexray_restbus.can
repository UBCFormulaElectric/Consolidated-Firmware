on start
{
  InitMessages();
  setTimerCyclic(tCycle_10ms, 10);
  setTimerCyclic(tCycle_20ms, 20);
  setTimerCyclic(tCycle_100ms, 100);
  setTimerCyclic(tCycle_250ms, 250);
  setTimerCyclic(tCycle_1000ms, 1000);
  write("hexray rest-bus sim: 132 periodic messages, 5 cycle groups");
}

on stopMeasurement
{
  cancelTimer(tCycle_10ms);
  cancelTimer(tCycle_20ms);
  cancelTimer(tCycle_100ms);
  cancelTimer(tCycle_250ms);
  cancelTimer(tCycle_1000ms);
}

/*
 * Not sent by this script: 138 event-driven messages (no GenMsgCycleTime),
 * e.g. bootloader traffic, Bootup and Debug commands. Send them from the Interactive
 * Generator or add handlers here:
 *   BMS        0x198 BMS_Bootup
 *   BMS        0x1A3 BMS_CellVoltageStats
 *   BMS        0x1A4 BMS_CellTempStats
 *   BMS        0x1A5 BMS_SegmentVoltageStats
 *   BMS        0x1A6 BMS_CellVoltages_Seg0_Seg1
 *   BMS        0x1A7 BMS_CellVoltages_Seg2_Seg3
 *   BMS        0x1A8 BMS_CellVoltages_Seg4_Seg5
 *   BMS        0x1AA BMS_CellVoltages_Seg6_Seg7
 *   BMS        0x1AB BMS_CellVoltages_Seg8_Seg9
 *   BMS        0x1AC BMS_CellTemps_Seg0_Seg1
 *   BMS        0x1AD BMS_CellTemps_Seg2_Seg3
