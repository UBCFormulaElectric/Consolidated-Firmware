void SendFd(message * m, int ch, int len)
{
  m.CAN = ch;
  m.FDF = 1;
  m.BRS = 0;
  m.DataLength = len;
  output(m);
}

void SendClassic(message * m, int ch, int len)
{
  m.CAN = ch;
  m.FDF = 0;
  m.BRS = 0;
  m.DLC = len;
  output(m);
}

