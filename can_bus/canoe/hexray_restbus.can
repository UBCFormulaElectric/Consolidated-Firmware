  if (gSim_CRIT) Send_CRIT_InfoCounts();
  if (gSim_CRIT) Send_CRIT_CPUDataLogInfo();
  if (gSim_DAM) Send_DAM_Vitals();
  if (gSim_DAM) Send_DAM_Warnings();
  if (gSim_DAM) Send_DAM_Faults();
  if (gSim_DAM) Send_DAM_WarningsCounts();
  if (gSim_DAM) Send_DAM_FaultsCounts();
  if (gSim_DAM) Send_DAM_Info();
  if (gSim_DAM) Send_DAM_InfoCounts();
  if (gSim_DAM) Send_DAM_CommitInfo();
  if (gSim_DAM) Send_DAM_CPUDataLogInfo();
  if (gSim_Debug) Send_Debug_Charging();
  if (gSim_Debug) Send_Debug_ResetSoc();
  if (gSim_Debug) Send_Debug_SetBSPDTestCurrent();
  if (gSim_EMeter) Send_EMeter_Status();
  if (gSim_FSM) Send_FSM_Vitals();
  if (gSim_FSM) Send_FSM_Warnings();
  if (gSim_FSM) Send_FSM_Faults();
  if (gSim_FSM) Send_FSM_WarningsCounts();
  if (gSim_FSM) Send_FSM_FaultsCounts();
  if (gSim_FSM) Send_FSM_Info();
  if (gSim_FSM) Send_FSM_InfoCounts();
  if (gSim_FSM) Send_FSM_CommitInfo();
  if (gSim_FSM) Send_FSM_Suspension();
  if (gSim_FSM) Send_FSM_CPUDataLogInfo();
  if (gSim_RSM) Send_RSM_Vitals();
  if (gSim_RSM) Send_RSM_Faults();
  if (gSim_RSM) Send_RSM_Warnings();
  if (gSim_RSM) Send_RSM_FaultsCounts();
  if (gSim_RSM) Send_RSM_WarningsCounts();
  if (gSim_RSM) Send_RSM_Info();
  if (gSim_RSM) Send_RSM_InfoCounts();
  if (gSim_RSM) Send_RSM_Brakes();
  if (gSim_RSM) Send_RSM_ShdnNodeStatus();
  if (gSim_RSM) Send_RSM_RearLeftPumpPercentage();
  if (gSim_RSM) Send_RSM_CPUDataLogInfo();
  if (gSim_VC) Send_VC_Faults();
  if (gSim_VC) Send_VC_Warnings();
  if (gSim_VC) Send_VC_FaultsCounts();
  if (gSim_VC) Send_VC_WarningsCounts();
  if (gSim_VC) Send_VC_Info();
  if (gSim_VC) Send_VC_InfoCounts();
  if (gSim_VC) Send_VC_CommitInfo();
  if (gSim_VC) Send_VC_VehicleDynamics();
  if (gSim_VC) Send_VC_EllipseEkfNavVelocity();
  if (gSim_VC) Send_VC_GlobalShdnNodeStatus();
  if (gSim_VC) Send_VC_EllipseTime();
  if (gSim_VC) Send_VC_EllipseStatus();
  if (gSim_VC) Send_VC_EllipseEulerAngles();
  if (gSim_VC) Send_VC_CPUDataLogInfo();
