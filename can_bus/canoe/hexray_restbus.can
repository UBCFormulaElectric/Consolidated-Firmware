on timer tCycle_250ms
{
  if (gSim_EMeter) Send_EMeter_Temperature();
}

on timer tCycle_1000ms
{
  if (gSim_BMS) Send_BMS_Debug();
  if (gSim_BMS) Send_BMS_HvBatteryProperties();
  if (gSim_BMS) Send_BMS_ImdData();
  if (gSim_BMS) Send_BMS_ElconControls();
  if (gSim_CRIT) Send_CRIT_Debug();
  if (gSim_DAM) Send_DAM_Debug();
  if (gSim_Debug) Send_Debug_CanMode();
  if (gSim_Debug) Send_Debug_CellBalancing();
  if (gSim_Elcon) Send_Elcon_Vitals();
  if (gSim_FSM) Send_FSM_Debug();
  if (gSim_RSM) Send_RSM_Debug();
  if (gSim_RSM) Send_RSM_CommitInfo();
  if (gSim_RSM) Send_RSM_SuspensionTravel();
  if (gSim_RSM) Send_RSM_Coolant();
  if (gSim_RSM) Send_RSM_TireSensor();
  if (gSim_VC) Send_VC_Debug();
}

on message EMeter_Measurement
{
  message * f;
  if (this.dir != RX) return;
  if (gSim_VC && !gSim_EMeter && this.CAN == CH_INVCAN)
  {
    f = this;
    SendFd(f, CH_FDCAN, 8);
  }
}

