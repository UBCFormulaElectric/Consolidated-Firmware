on timer tCycle_10ms
{
  if (gSim_BMS) Send_BMS_Vitals();
  if (gSim_BMS) Send_BMS_LatchStatus();
  if (gSim_BMS) Send_BMS_Contactors();
  if (gSim_BMS) Send_BMS_TractiveSystem();
  if (gSim_BMS) Send_BMS_BSPDStatus();
  if (gSim_BMS) Send_BMS_ImdStatus();
  if (gSim_BMS) Send_BMS_PowerLimit();
  if (gSim_BMS) Send_BMS_EvseCPStatus();
  if (gSim_DAM) Send_DAM_ShdnNodeStatus();
  if (gSim_Debug) Send_Debug_SetTorqueRequest();
  if (gSim_FSM) Send_FSM_Steering();
  if (gSim_FSM) Send_FSM_Apps();
  if (gSim_FSM) Send_FSM_Brake();
  if (gSim_FSM) Send_FSM_IMU();
  if (gSim_FSM) Send_FSM_ShdnNodeStatus();
  if (gSim_INVFL) Send_INVFL_FLInverterInfo1();
  if (gSim_INVFL) Send_INVFL_FLInverterInfo2();
  if (gSim_INVFL) Send_INVFL_FLInverterInfo3();
  if (gSim_INVFR) Send_INVFR_FRInverterInfo1();
  if (gSim_INVFR) Send_INVFR_FRInverterInfo2();
  if (gSim_INVFR) Send_INVFR_FRInverterInfo3();
  if (gSim_INVRL) Send_INVRL_RLInverterInfo1();
  if (gSim_INVRL) Send_INVRL_RLInverterInfo2();
  if (gSim_INVRL) Send_INVRL_RLInverterInfo3();
  if (gSim_INVRR) Send_INVRR_RRInverterInfo1();
  if (gSim_INVRR) Send_INVRR_RRInverterInfo2();
  if (gSim_INVRR) Send_INVRR_RRInverterInfo3();
  if (gSim_RSM) Send_RSM_IMU();
  if (gSim_VC) Send_VC_INVFLSetPoints();
  if (gSim_VC) Send_VC_INVFRSetPoints();
  if (gSim_VC) Send_VC_INVRLSetPoints();
  if (gSim_VC) Send_VC_INVRRSetPoints();
  if (gSim_VC) Send_VC_Vitals();
  if (gSim_VC) Send_VC_IMU1();
  if (gSim_VC) Send_VC_PumpStatus();
  if (gSim_VC) Send_VC_ConnectorBoardEfuse();
  if (gSim_VC) Send_VC_ShdnNodeStatus();
  if (gSim_VC) Send_VC_MainBoardEfuse();
  if (gSim_VC) Send_VC_PCM();
}

on timer tCycle_20ms
{
  if (gSim_EMeter) Send_EMeter_Measurement();
}

on timer tCycle_100ms
{
  if (gSim_BMS) Send_BMS_Faults();
  if (gSim_BMS) Send_BMS_Warnings();
  if (gSim_BMS) Send_BMS_FaultsCounts();
  if (gSim_BMS) Send_BMS_WarningsCounts();
  if (gSim_BMS) Send_BMS_Info();
  if (gSim_BMS) Send_BMS_InfoCounts();
  if (gSim_BMS) Send_BMS_CommitInfo();
  if (gSim_BMS) Send_BMS_Charger();
  if (gSim_BMS) Send_BMS_Fans();
  if (gSim_BMS) Send_BMS_BMSShdnNodeStatus();
  if (gSim_BMS) Send_BMS_CPUDataLogInfo();
  if (gSim_Boot) Send_Boot_BMS_Status();
  if (gSim_Boot) Send_Boot_VC_Status();
  if (gSim_Boot) Send_Boot_DAM_Status();
  if (gSim_Boot) Send_Boot_FSM_Status();
  if (gSim_Boot) Send_Boot_RSM_Status();
  if (gSim_Boot) Send_Boot_CRIT_Status();
  if (gSim_CRIT) Send_CRIT_Vitals();
  if (gSim_CRIT) Send_CRIT_CommitInfo();
